h = float(input ('请输入你的身高(m):'))
w = float(input ('请输入你的体重(kg):'))
BMI= w/h**2
Bmi = round(BMI,2)
print('BMI:',Bmi)
if BMI < 18.5:
    print('偏瘦')
    print('💡建议：适当增加优质蛋白，（鸡肉，牛奶，瘦肉),少食多餐，规律作息，循序渐进循序渐进进行力量训练，不要熬夜')
elif 18.5 <= BMI < 24:
    print('正常')
    print('💡建议：继续保持均衡饮食，坚持每周运动，维持当前健康的生活习惯')
elif 24 <= BMI <28:
    print ('超重')
    print('💡建议：控制油炸、甜食、饮料；增加有氧运动（慢走、慢跑），三餐规律，减少夜宵')
else:
    print('肥胖')
    print('💡建议：清淡饮食，减少高油高糖食物；坚持规律运动，可以从低强度有氧开始，必要时咨询医生')